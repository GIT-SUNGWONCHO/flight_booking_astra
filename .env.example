# 계정 정보. 이 파일(.env.example)은 형식만 담고 저장소에 들어간다.
# 실제 값은 옆에 .env 를 만들어 거기에만 적는다 (.gitignore 로 막혀 있다).
#
#   copy .env.example .env      그리고 .env 를 열어 값을 채운다
#
# 비밀번호를 대화창에 붙여넣지 말 것. 파일에 직접 적는 편이 안전하다.

# --- 9222 실전 예약: 와이프 스카이패스 계정 (아이디 + 비밀번호로 로그인) ---
KE_SKYPASS_ID=
KE_SKYPASS_PW=
# 로그인 화면에 탭이 둘이다: 아이디 / 스카이패스 번호. 기본 탭은 '아이디' 라서
# 스카이패스 번호를 그냥 넣으면 "일치하는 회원정보가 없습니다" 가 뜬다.
# 비워두면 위 값이 숫자뿐일 때 스카이패스 탭으로 본다. 강제하려면 적는다.
#   KE_LOGIN_TAB=스카이패스      또는      KE_LOGIN_TAB=아이디
KE_LOGIN_TAB=

# --- 9223 계측: 본인 계정 (네이버 연동으로 로그인. 보통 비밀번호가 필요 없다) ---
# 네이버 세션이 살아 있으면 비워 두어도 된다. 세션이 자주 풀리면 채운다.
NAVER_ID=
NAVER_PW=

# --- Astra 9232 예매 로그인 방식 (2026-09-12 사용자 확정) ---
# 비우면 기본값: 본인 네이버 연동으로 로그인한다(9232·9233 동일).
# skypass 로 두면 9232 는 위 KE_SKYPASS_ID/PW 로 로그인하고, 실패해도
# 네이버로 전환하지 않는다(계정이 다르기 때문).
#   KE_LOGIN_MODE=skypass
KE_LOGIN_MODE=<값>
